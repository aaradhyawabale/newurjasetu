# ==============================================================================
# UrjaSetu Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required on Backend / Render)
# ------------------------------------------------------------------------------
# Production: Use your cloud PostgreSQL connection string from Neon / Supabase.
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Local dev: "file:./dev.db" (if using SQLite) or local Postgres
DATABASE_URL="postgresql://user:password@host/urjasetu?sslmode=require" # <-- REPLACE: Get this in Phase 4 from your Neon / Supabase dashboard

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Required on Backend / Render)
# ------------------------------------------------------------------------------
# 32+ character random secret used by jose to sign and verify session JWT cookies.
# Generate one using: openssl rand -hex 32
SESSION_SECRET="urjasetu_super_secret_production_session_key_32bytes_min_xyz123" # <-- Set a random 32+ character string

# ------------------------------------------------------------------------------
# 3. INTER-SERVICE NETWORKING (CORS & PROXY REWRITES)
# ------------------------------------------------------------------------------
# Set this on VERCEL (Frontend): Points to your live Render backend URL so Vercel proxies /api/* requests.
BACKEND_URL="https://urjasetu-api.onrender.com" # <-- REPLACE: We will get this in Phase 5 after deploying on Render (NO trailing slash)

# Set this on RENDER (Backend): Allows cross-origin requests from your Vercel deployment.
FRONTEND_URL="https://urjasetu.vercel.app" # <-- REPLACE: We will get this in Phase 6 after deploying on Vercel (NO trailing slash)

# ------------------------------------------------------------------------------
# 4. EXTERNAL GEOSPATIAL & CLIMATE PROVIDERS (Ready-to-use defaults)
# ------------------------------------------------------------------------------
# User-Agent for OSM / Nominatim / Overpass (Required by their terms of service)
GEO_USER_AGENT="UrjaSetu-GIS-Planner/1.0 (academic-urban-planning-tool; contact@urjasetu.local)"

# OpenStreetMap Overpass API (Candidates & GIS queries)
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
OVERPASS_BACKUP_URL="https://overpass.kumi.systems/api/interpreter"

# Nominatim Geocoding API (Search location by name)
NOMINATIM_API_URL="https://nominatim.openstreetmap.org"

# Open-Meteo Climate APIs (Elevation & Weather archive)
OPEN_METEO_ELEVATION_URL="https://api.open-meteo.com/v1/elevation"
OPEN_METEO_ARCHIVE_URL="https://archive-api.open-meteo.com/v1/archive"

# NASA POWER API (Solar irradiance climatology)
NASA_POWER_API_URL="https://power.larc.nasa.gov/api/temporal/climatology/point"

# ------------------------------------------------------------------------------
# 5. AI COPILOT & LLM (Optional / Ready Defaults)
# ------------------------------------------------------------------------------
LLM_PROVIDER="nugen"
NUGEN_BASE_URL="https://api.nugen.in/api/v3"
NUGEN_MODEL="meta-llama/Llama-3.2-3B-Instruct"
NUGEN_API_KEY="" # <-- OPTIONAL: Enter your NuGen AI key here if you have one, or configure it via the in-app drawer

# ------------------------------------------------------------------------------
# 6. FEATURE FLAGS & MAP STYLES
# ------------------------------------------------------------------------------
# Priority Engine 250m cell grid (true enables priority maps and model card)
NEXT_PUBLIC_PRIORITY_MODE="true"

# Optional custom map tile style (Leave empty to use default OpenStreetMap raster tiles)
NEXT_PUBLIC_MAP_STYLE=""
