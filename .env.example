# Database (SQLite for zero-config local development, or PostgreSQL URL)
DATABASE_URL="file:./dev.db"

# Auth Session Secret (used for signing secure HTTP-only cookies)
SESSION_SECRET="urjasetu_super_secret_development_session_key_32bytes_min"

# Map Configuration
# Note: OSM tile servers have usage policies. Do not use for high volume production.
# Hosted vector or raster tile endpoints can be provided here.
NEXT_PUBLIC_MAP_STYLE=""

# External Geospatial Data Providers
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
OVERPASS_BACKUP_URL="https://overpass.kumi.systems/api/interpreter"
NOMINATIM_API_URL="https://nominatim.openstreetmap.org"
OPEN_METEO_ELEVATION_URL="https://api.open-meteo.com/v1/elevation"
OPEN_METEO_ARCHIVE_URL="https://archive-api.open-meteo.com/v1/archive"
NASA_POWER_API_URL="https://power.larc.nasa.gov/api/temporal/climatology/point"

# User-Agent for OpenStreetMap / Nominatim / Overpass (Required by terms of service)
GEO_USER_AGENT="UrjaSetu-GIS-Planner/1.0 (academic-urban-planning-tool; contact@urjasetu.local)"

# Optional AI Narrative Generation (P1 feature - if set, provides AI synthesis of computed results)
# ANTHROPIC_API_KEY=""
