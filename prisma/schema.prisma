datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  scenarios    Scenario[]
  placements   Placement[]
  analyses     Analysis[]

  @@index([email])
}

model Scenario {
  id         String      @id @default(uuid())
  userId     String
  name       String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  placements Placement[]

  @@index([userId])
  @@index([createdAt])
}

model Placement {
  id         String     @id @default(uuid())
  scenarioId String
  userId     String
  type       String     // Hospital, School, Park, Road, Bridge, Water Canal, Building, Transit Station, Drainage, Solar Farm
  lat        Float
  lng        Float
  lengthM    Float
  widthM     Float
  bearingDeg Float      @default(0)
  params     String     @default("{}") // JSON string of type-specific parameters
  label      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario   Scenario   @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  analyses   Analysis[]

  @@index([userId])
  @@index([scenarioId])
  @@index([createdAt])
}

model Analysis {
  id            String    @id @default(uuid())
  placementId   String
  userId        String
  engineVersion String    @default("1.0.0")
  overallScore  Float
  scoreBand     String    // High Suitability, Moderate Suitability, Low Suitability, Highly Constrained, Unsuitable
  input         String    // JSON snapshot of placement and site conditions
  result        String    // Full JSON analysis result object
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  placement     Placement @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([placementId])
  @@index([createdAt])
}

model ProviderCache {
  key       String   @id
  response  String   // JSON string
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model Plan {
  id              String        @id @default(uuid())
  title           String        @default("Untitled Municipal Heat Plan")
  status          String        @default("Draft") // Draft | Saved | Forwarded
  isDeleted       Boolean       @default(false)
  inputsSnapshot  String        @default("{}") // JSON string of budget, ward, targetNdvi, scenario
  outputsSnapshot String        @default("{}") // JSON string of totals, selectedZones, versions
  sections        String        @default("{}") // JSON string of tool items: zones, sites, interventions, shading
  notes           String        @default("")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  versions        PlanVersion[]
  events          PlanEvent[]

  @@index([status])
  @@index([createdAt])
}

model PlanVersion {
  id              String      @id @default(uuid())
  planId          String
  versionNumber   Int
  versionName     String
  inputsSnapshot  String      @default("{}") // JSON string
  outputsSnapshot String      @default("{}") // JSON string
  sections        String      @default("{}") // JSON string
  notes           String      @default("")
  createdAt       DateTime    @default(now())
  plan            Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([createdAt])
}

model PlanEvent {
  id         String   @id @default(uuid())
  planId     String
  eventType  String   // Created | Updated | VersionSaved | Forwarded
  recipient  String?  // Recipient role/name
  notes      String?
  timestamp  DateTime @default(now())
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([timestamp])
}

